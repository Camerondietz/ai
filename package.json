{
  "name": "ai-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first, frontend-only AI workbench for day-to-day AI operations and engineering.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prepare-runtime": "node scripts/copy-ort.mjs",
    "dev": "npm run prepare-runtime && vite",
    "build": "npm run prepare-runtime && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@huggingface/hub": "^2.17.6",
    "@huggingface/transformers": "^4.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
